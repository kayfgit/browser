# Rust build output
**/target/
**/*.rs.bk

# Compiled/native artifacts and locally downloaded Windows toolchains
*.exe
*.dll
*.lib
*.exp
*.obj
*.ilk
*.vsix

# We DO commit Cargo.lock: this workspace produces a binary, and a locked
# dependency set keeps builds reproducible. (Only libraries omit it.)

# Backtraces / debugging
*.pdb
*.dmp
*.log

# Browser runtime data and native smoke-test output (also outside target/)
*.WebView2/
# Indexes Chromium writes into an unpacked extension when it loads one
crates/desktop/extensions/*/_metadata/
desktop-smoke/
installed-smoke/

# Local config overrides (sample lives at config/config.toml)
/config/local.toml

# Machine-specific coding-assistant settings and scratch state
/.claude/
/.codex/

# Editor / IDE
/.vscode/
/.idea/
*.swp
*.swo
*~

# OS cruft
Thumbs.db
desktop.ini
.DS_Store

# Environment / secrets
.env
.env.*
